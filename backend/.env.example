# Copy this file to .env and fill in your values

# JWT secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret-string

# Port (Render sets PORT automatically)
PORT=3001

# Allowed CORS origin (your GitHub Pages URL)
CORS_ORIGIN=https://7799sai-sai.github.io

# SQLite database file path (relative to backend/)
DB_PATH=./keystone.db
